# Copiar este archivo como ".env" y ajustar con tus credenciales locales de PostgreSQL.
# NUNCA subir el archivo ".env" real a GitHub.

DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA_LOCAL@localhost:5432/hermandad_dolores_mvp

# Modo de repositorio:
# false = usa PostgreSQL 16 real (RepositorioCitaSQL) -> modo obligatorio para demo local
# true  = usa repositorio en memoria (RepositorioCitaMemoria) -> solo para pruebas unitarias sin BD
USE_MEMORY_REPO=false

APP_HOST=127.0.0.1
APP_PORT=8000
