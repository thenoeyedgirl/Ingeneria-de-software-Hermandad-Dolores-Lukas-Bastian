# Copiar este archivo como ".env" y ajustar con tus credenciales locales.
# NUNCA subir el archivo ".env" real a GitHub.

DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA_LOCAL@localhost:5432/hermandad_dolores_mvp
USE_MEMORY_REPO=false
APP_HOST=127.0.0.1
APP_PORT=8000

# ==============================================================================
# META WHATSAPP CLOUD API (Opcional para demo en vivo; si se deja vacío usa modo simulado)
# ==============================================================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=hermandad_dolores_webhook_2026
# En modo prueba Meta solo entrega a números autorizados. Si colocas tu celular
# (ej: 56912345678), los avisos de pacientes ficticios llegarán a tu WhatsApp.
WHATSAPP_TEST_TO=
